# Environment Configuration for THE FORGE

# ==========================================
# AI Provider Selection (BYOK - Bring Your Own Key)
# ==========================================
# Choose your AI provider: 'venice' (privacy-first, default) or 'gemini'
AI_PROVIDER=venice

# ==========================================
# Venice.ai Configuration (Recommended - Privacy-First)
# ==========================================
# Venice.ai API key - Get yours at: https://venice.ai/api
# Features: Zero data retention, uncensored, open-source models
VENICE_API_KEY=your_venice_api_key_here

# Anonymous mode (default: true)
# When enabled: No user identifiers sent, Venice system prompts disabled
ANONYMOUS_MODE=true

# Web search (default: off for privacy)
# Options: 'off', 'on', 'auto'
ENABLE_WEB_SEARCH=off
ENABLE_WEB_CITATIONS=false

# ==========================================
# Gemini API Configuration (Alternative)
# ==========================================
# Your Google Gemini API key
# Get one at: https://aistudio.google.com/app/apikey
# Note: Gemini stores data per Google Cloud terms
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# Server Configuration
# ==========================================
# Port for the Express server
PORT=3001

# Node environment (development, production, test)
NODE_ENV=development

# ==========================================
# Model Configuration (Common Settings)
# ==========================================
# Temperature controls randomness (0.0-2.0)
# Lower = more deterministic, Higher = more creative
TEMPERATURE=0.7

# Maximum tokens for model output
MAX_OUTPUT_TOKENS=32000

# Gemini-specific settings
TOP_P=0.95
TOP_K=40

# ==========================================
# Framework Paths
# ==========================================
FRAMEWORKS_PATH=../data/frameworks
