# Environment Configuration for THE FORGE

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=3001
NODE_ENV=development

# Generation Settings
MAX_OUTPUT_TOKENS=32000
TEMPERATURE=0.7
TOP_P=0.95
TOP_K=40

# Framework Paths
FRAMEWORKS_PATH=../data/frameworks
